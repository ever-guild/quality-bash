{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ever-guild/quality-bash/v1.0.0-alpha.2/internal/quality/schema/baseline-v2.schema.json",
  "title": "quality-bash baseline v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "files", "method", "coverage", "mutation"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/ever-guild/quality-bash/v1.0.0-alpha.2/internal/quality/schema/baseline-v2.schema.json"},
    "schema": {"const": 2},
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage", "mutation", "tools", "operators", "parameters"],
      "properties": {
        "coverage": {"type": "string", "minLength": 1},
        "mutation": {"type": "string", "minLength": 1},
        "tools": {
          "type": "object", "additionalProperties": false,
          "required": ["bash", "bats", "shellcheck", "kcov"],
          "properties": {
            "bash": {"type": "string", "minLength": 1},
            "bats": {"type": "string", "minLength": 1},
            "shellcheck": {"type": "string", "minLength": 1},
            "kcov": {"type": "string", "minLength": 1}
          }
        },
        "operators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "parameters": {
          "type": "object", "additionalProperties": false, "required": ["parser"],
          "properties": {"parser": {"type": "string", "minLength": 1}}
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["coveredLines", "totalLines"],
      "properties": {"coveredLines": {"$ref": "#/$defs/count"}, "totalLines": {"$ref": "#/$defs/positiveCount"}}
    },
    "mutation": {
      "type": "object", "additionalProperties": false, "required": ["killed", "survived"],
      "properties": {"killed": {"$ref": "#/$defs/count"}, "survived": {"$ref": "#/$defs/count"}}
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "positiveCount": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
  }
}
