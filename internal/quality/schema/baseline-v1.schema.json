{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,
 "required":["schema","files","method","coverage","mutation"],
 "properties":{
  "schema":{"const":1},
  "files":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
  "method":{
   "type":"object","additionalProperties":false,"required":["coverage","tools","mutation","operators","parameters"],
   "properties":{
    "coverage":{"type":"string"},"mutation":{"type":"string"},
    "tools":{"type":["object","null"],"additionalProperties":{"type":"string"}},
    "operators":{"type":["array","null"],"uniqueItems":true,"items":{"type":"string"}},
    "parameters":{"type":["object","null"],"additionalProperties":{"type":"string"}}
   }
  },
  "coverage":{"$ref":"#/$defs/ratio"},"mutation":{"$ref":"#/$defs/ratio"}
 },
 "$defs":{"ratio":{
  "type":"object","additionalProperties":false,"required":["numerator","denominator"],
  "properties":{"numerator":{"type":"integer","minimum":0},"denominator":{"type":"integer","minimum":1}}
 }}
}
