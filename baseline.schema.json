{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ever-guild/quality-bash/v1.0.0-alpha.3/baseline.schema.json",
  "title": "quality-bash baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "files",
    "method",
    "coverage",
    "mutation"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/ever-guild/quality-bash/v1.0.0-alpha.3/baseline.schema.json"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "mutation",
        "tools"
      ],
      "properties": {
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "operators",
            "parser"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "operators": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "parser": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bash",
            "bats",
            "shellcheck",
            "kcov"
          ],
          "properties": {
            "bash": {
              "type": "string",
              "minLength": 1
            },
            "bats": {
              "type": "string",
              "minLength": 1
            },
            "shellcheck": {
              "type": "string",
              "minLength": 1
            },
            "kcov": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linePercent"
      ],
      "properties": {
        "linePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01
        }
      }
    }
  }
}
